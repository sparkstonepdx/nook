#!/bin/bash
# app-grant: which hostnames each app may serve.  (root)
#   app-grant list [APP]
#   app-grant add APP domain client.com      client.com and every *.client.com
#   app-grant add APP sub    client.com      *.client.com only, not client.com itself
#   app-grant add APP host   blog.client.com exactly that hostname
#   app-grant rm  APP KIND NAME
# Grants live in $GRANTS_FILE as "app kind name" lines. Changes re-sync the app.
set -euo pipefail
. /etc/apps/config
GRANTS_FILE="${GRANTS_FILE:-/etc/apps/grants}"
touch "$GRANTS_FILE"; chmod 600 "$GRANTS_FILE"
usage() { sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
host_re='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$'

case "${1:-}" in
  list) if [ -n "${2:-}" ]; then awk -v a="$2" '$1==a' "$GRANTS_FILE"; else cat "$GRANTS_FILE"; fi;;
  add|rm)
    [ $# = 4 ] || usage
    a="$2" k="$3" n="${4,,}"
    [[ "$a" =~ ^[a-z][a-z0-9-]{1,23}$ ]] && id "app-$a" >/dev/null 2>&1 || { echo "no such app: $a"; exit 1; }
    [[ "$k" =~ ^(domain|sub|host)$ ]] || usage
    [[ "$n" =~ $host_re ]] && [ ${#n} -le 253 ] || { echo "not a valid domain: $n"; exit 1; }
    exec 9>/run/app-sync.lock; flock 9
    if [ "$1" = add ]; then
      grep -qxF "$a $k $n" "$GRANTS_FILE" || echo "$a $k $n" >> "$GRANTS_FILE"
    else
      grep -vxF "$a $k $n" "$GRANTS_FILE" > "$GRANTS_FILE.tmp" || true
      mv "$GRANTS_FILE.tmp" "$GRANTS_FILE"; chmod 600 "$GRANTS_FILE"
    fi
    flock -u 9; exec 9>&-
    app-sync "$a";;
  *) usage;;
esac
