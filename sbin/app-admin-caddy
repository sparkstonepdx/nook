#!/bin/bash
# app-admin-caddy: (re)write /etc/caddy/admin.caddy for the dashboard and reload Caddy.  (root)
#   https://<server ip>:8443   always (self-signed): first setup, and the way in if DNS breaks
#   https://DASHBOARD_HOST     once you set an address on the dashboard's Domains page
# Settings in /etc/apps/dashboard.env: DASHBOARD_HOST, DASHBOARD_PORT, DASHBOARD_IP_PORT, DASHBOARD_IP_ACCESS (on|off)
set -euo pipefail
. /etc/apps/config
DASHBOARD_HOST="" DASHBOARD_PORT=19999 DASHBOARD_IP_ACCESS=on DASHBOARD_IP_PORT=8443
# shellcheck disable=SC1091
[ -f /etc/apps/dashboard.env ] && . /etc/apps/dashboard.env
out=/etc/caddy/admin.caddy; old=$(cat "$out" 2>/dev/null || true)
{
  echo "# generated by app-admin-caddy: do not edit"
  [ -n "$DASHBOARD_HOST" ] && printf '%s {\n\treverse_proxy 127.0.0.1:%s\n}\n' "$DASHBOARD_HOST" "$DASHBOARD_PORT"
  if [ "$DASHBOARD_IP_ACCESS" = on ]; then
    printf 'https://%s:%s {\n\ttls internal\n\treverse_proxy 127.0.0.1:%s\n}\n' "$SSH_HOST" "$DASHBOARD_IP_PORT" "$DASHBOARD_PORT"
  fi
} > "$out.new"
mv "$out.new" "$out"
grep -qxF "import $out" /etc/caddy/Caddyfile || printf '\nimport %s\n' "$out" >> /etc/caddy/Caddyfile
if caddy validate --config /etc/caddy/Caddyfile >/dev/null 2>&1; then
  [ "$(cat "$out")" = "$old" ] || systemctl reload caddy
else
  if [ -n "$old" ]; then printf '%s\n' "$old" > "$out"; else rm -f "$out"; fi
  echo "Caddy config failed to validate; kept the previous one"; exit 1
fi
[ "$DASHBOARD_IP_ACCESS" = on ] && echo "dashboard: https://$SSH_HOST:$DASHBOARD_IP_PORT (self-signed certificate)"
[ -n "$DASHBOARD_HOST" ] && echo "dashboard: https://$DASHBOARD_HOST"
exit 0
