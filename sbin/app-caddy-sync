#!/bin/bash
# app-caddy-sync NAME | --all
# Regenerates /etc/caddy/apps/NAME.caddy from the app's app.env. Runs as root (triggered when app.env is saved).
# app.env is written by the app user, so it is parsed as plain text and validated, never sourced.
set -euo pipefail
. /etc/apps/config

valid_sub() {  # app key value outfile
  local sub="$3"
  if ! [[ "$sub" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$ ]]; then
    echo "$1: $2='$sub' is not a valid subdomain, skipped"; return 1; fi
  if tr ' ' '\n' <<< "$RESERVED_SUBDOMAINS" | grep -qx -F "$sub"; then
    echo "$1: '$sub' is reserved, skipped"; return 1; fi
  # a hostname belongs to whichever app claimed it first
  if grep -l -x -F "$sub.$BASE_DOMAIN {" "$CADDY_APPS_DIR"/*.caddy 2>/dev/null | grep -v -x -F "$4" | grep -q .; then
    echo "$1: $sub.$BASE_DOMAIN is already used by another app, skipped"; return 1; fi
}

sync_one() {
  local name="$1" dir="$APPS_DIR/$1" out="$CADDY_APPS_DIR/$1.caddy" tmp
  local ports; ports=$(awk -v n="$name" '$1==n {print $2, $3, $4, $5}' "$PORTS_FILE")
  [ -n "$ports" ] || { echo "$name: no ports registered"; return 1; }
  read -r -a P <<< "$ports"
  tmp=$(mktemp)
  echo "# generated by app-caddy-sync from $dir/app.env: do not edit" > "$tmp"
  for i in 1 2 3 4; do
    local sub; sub=$(grep -E "^APP_SUBDOMAIN_$i=" "$dir/app.env" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '[:space:]"'"'" || true)
    [ -z "$sub" ] && continue
    valid_sub "$name" "APP_SUBDOMAIN_$i" "$sub" "$out" || continue
    grep -qx -F "$sub.$BASE_DOMAIN {" "$tmp" && { echo "$name: $sub used twice in app.env, skipped"; continue; }
    local host="$sub.$BASE_DOMAIN"
    printf '%s {\n\treverse_proxy 127.0.0.1:%s\n}\n' "$host" "${P[$((i-1))]}" >> "$tmp"
  done
  # static site
  local ssub sroot
  ssub=$(grep -E "^STATIC_SUBDOMAIN=" "$dir/app.env" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '[:space:]"'"'" || true)
  sroot=$(grep -E "^STATIC_ROOT=" "$dir/app.env" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '[:space:]"'"'" || true)
  sroot="${sroot:-current}"
  if [ -n "$ssub" ]; then
    if ! valid_sub "$name" "STATIC_SUBDOMAIN" "$ssub" "$out"; then :
    elif ! [[ "$sroot" =~ ^[A-Za-z0-9._/-]+$ ]] || [[ "$sroot" == *..* ]] || [[ "$sroot" == /* ]]; then
      echo "$name: STATIC_ROOT='$sroot' must be a path inside the app folder, skipped"
    else
      printf '%s {\n\troot * %s\n\ttry_files {path} {path}/ /200.html\n\tfile_server\n\thandle_errors {\n\t\trewrite * /404.html\n\t\tfile_server\n\t}\n}\n' \
        "$ssub.$BASE_DOMAIN" "$dir/$sroot" >> "$tmp"
    fi
  fi
  local old=""; [ -f "$out" ] && old=$(cat "$out")
  install -m 644 "$tmp" "$out"; rm -f "$tmp"
  if caddy validate --config /etc/caddy/Caddyfile >/dev/null 2>&1; then
    [ "$(cat "$out")" = "$old" ] || systemctl reload caddy
    echo "$name: $(grep -c ' {$' "$out") route(s) active"
  else
    if [ -n "$old" ]; then printf '%s\n' "$old" > "$out"; else rm -f "$out"; fi
    echo "$name: generated config failed caddy validate; kept the previous one"; return 1
  fi
}

if [ "${1:-}" = "--all" ]; then
  awk '{print $1}' "$PORTS_FILE" | while read -r n; do sync_one "$n" || true; done
else
  [ -n "${1:-}" ] || { echo "usage: app-caddy-sync NAME | --all"; exit 1; }
  sync_one "$1"
fi
