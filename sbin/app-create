#!/bin/bash
# app-create NAME [--memory 256M] [--cpu 50%] [--tasks 256]
# Creates an isolated app user + folder (/srv/apps/NAME) and a deploy key for GitHub Actions,
# then prints the secrets/variables to paste into the repo and instructions to hand to Claude.
set -euo pipefail
. /etc/apps/config

NAME="${1:-}"; shift || true
MEM="$APP_MEMORY_MAX"; CPU="$APP_CPU_QUOTA"; TASKS="$APP_TASKS_MAX"
while [ $# -gt 0 ]; do case "$1" in
  --memory) MEM="$2"; shift 2;; --cpu) CPU="$2"; shift 2;; --tasks) TASKS="$2"; shift 2;;
  *) echo "unknown option $1"; exit 1;; esac; done
[[ "$NAME" =~ ^[a-z][a-z0-9-]{1,23}$ ]] || { echo "usage: app-create NAME [--memory 256M] [--cpu 50%] [--tasks 256]"; exit 1; }
[ "$(id -u)" = 0 ] || { echo "run as root"; exit 1; }
U="app-$NAME"; DIR="$APPS_DIR/$NAME"
id "$U" >/dev/null 2>&1 && { echo "$U already exists"; exit 1; }

# --- user + folder. Home is 711: others can't list it, but Caddy can reach the static files in sites/ ---
useradd --system --home-dir "$DIR" --create-home --shell /bin/bash --user-group "$U"
mkdir -p "$DIR/.ssh" "$DIR/sites" "$DIR/logs" "$DIR/builds" "$DIR/data"
# shellcheck disable=SC2016  # literal, expanded at login
echo 'export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"' > "$DIR/.profile"
cp "$DIR/.profile" "$DIR/.bashrc"
: > "$DIR/secrets.env"

# --- deploy key: GitHub Actions gets the private half, the server keeps the public half ---
KEYTMP=$(mktemp -d); trap 'rm -rf "$KEYTMP"' EXIT
ssh-keygen -q -t ed25519 -N "" -C "github-actions-$NAME" -f "$KEYTMP/key"
echo "restrict $(cat "$KEYTMP/key.pub")" > "$DIR/.ssh/authorized_keys"

chown -R "$U:$U" "$DIR"
chmod 711 "$DIR"; chmod 755 "$DIR/sites" "$DIR/logs"; chmod 700 "$DIR/.ssh" "$DIR/builds" "$DIR/data"
chmod 600 "$DIR/.ssh/authorized_keys" "$DIR/secrets.env"

# --- resource limits shared by everything this app runs ---
cat > "/etc/systemd/system/app-$NAME.slice" <<EOF
[Unit]
Description=Resource limits for app $NAME

[Slice]
MemoryMax=$MEM
CPUQuota=$CPU
TasksMax=$TASKS
EOF
systemctl daemon-reload
systemctl enable --now "app-sync@$NAME.path" >/dev/null 2>&1 || echo "warning: could not start the sites/ watcher"

KNOWN_HOSTS="$SSH_HOST $(cut -d' ' -f1,2 /etc/ssh/ssh_host_ed25519_key.pub)"
cat <<EOF

================ GitHub repo: Settings > Secrets and variables > Actions ================

--- Secrets ---
DEPLOY_HOST
$SSH_HOST

DEPLOY_USER
$U

DEPLOY_KNOWN_HOSTS
$KNOWN_HOSTS

DEPLOY_SSH_KEY
$(cat "$KEYTMP/key")

--- Variables ---
APP_DIR       $DIR
BASE_DOMAIN   $BASE_DOMAIN

================ Paste this to Claude ================

Write the GitHub Actions workflow(s) that deploy this repo to my server.

How the server works (already set up, don't change it):
- SSH as \${{ secrets.DEPLOY_USER }}@\${{ secrets.DEPLOY_HOST }} with the private key in secrets.DEPLOY_SSH_KEY. Write secrets.DEPLOY_KNOWN_HOSTS to ~/.ssh/known_hosts; never disable host key checking. No root, no sudo, no pty. The user can only write inside \${{ vars.APP_DIR }}.
- Every folder in \${{ vars.APP_DIR }}/sites/ is live at https://<folder>.\${{ vars.BASE_DOMAIN }} within a few seconds, and goes away when the folder is deleted. Folder names: lowercase letters, digits, dashes.
  - Static site (Surge-style): just files. 200.html is the SPA fallback, 404.html the not-found page.
  - Running app: if the folder contains an executable named "run", the server starts it as a service with the working directory set to that folder. It must listen on 127.0.0.1:\$PORT. Also in its environment: \$SITE (the folder/subdomain), \$SITE_HOST (the full hostname), \$HOME. Caddy proxies HTTPS and websockets to it. It's restarted on redeploy and on crash. Logs go to \${{ vars.APP_DIR }}/logs/<folder>.log. Runtime secrets: write them to \${{ vars.APP_DIR }}/secrets.env (KEY=value lines) from repo secrets; every running app gets them as environment variables.
  - A running app can only see its own app folder; keep anything persistent in \${{ vars.APP_DIR }}/data/, never inside the site folder (a redeploy replaces it).
- Deploy with the helper on the server (atomic swap, triggers the restart):
    rsync -a --delete ./out/ \${{ secrets.DEPLOY_USER }}@\${{ secrets.DEPLOY_HOST }}:builds/<name>/
    ssh ... app site deploy builds/<name> <subdomain>
  Other commands: app site rm <subdomain>, app site restart <subdomain>, app site list, app site logs <subdomain>.
- Build in the Action (the server has 1 GB RAM). For binaries, build for x86_64 Linux (glibc, Debian 13).
- Production: deploy main to the repo's subdomain. PR previews: deploy pull requests to <name>-pr-<number>, post the URL as a PR comment, and run "app site rm" when the PR closes.
EOF
