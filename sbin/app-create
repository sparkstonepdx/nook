#!/bin/bash
# app-create NAME [--memory 256M] [--cpu 50%] [--tasks 256] [--repo owner/name]
# Creates an isolated app user + folder (/srv/apps/NAME) and a deploy key for GitHub Actions,
# then prints the one APP_HOST secret for the repo and a ready-to-use deploy workflow.
set -euo pipefail
. /etc/apps/config

NAME="${1:-}"; shift || true
MEM="$APP_MEMORY_MAX"; CPU="$APP_CPU_QUOTA"; TASKS="$APP_TASKS_MAX"; REPO="OWNER/REPO"
while [ $# -gt 0 ]; do case "$1" in
  --memory) MEM="$2"; shift 2;; --cpu) CPU="$2"; shift 2;; --tasks) TASKS="$2"; shift 2;; --repo) REPO="$2"; shift 2;;
  *) echo "unknown option $1"; exit 1;; esac; done
[[ "$NAME" =~ ^[a-z][a-z0-9-]{1,23}$ ]] || { echo "usage: app-create NAME [--memory 256M] [--cpu 50%] [--tasks 256] [--repo owner/name]"; exit 1; }
[[ "$REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || { echo "--repo must look like owner/name"; exit 1; }
[ "$(id -u)" = 0 ] || { echo "run as root"; exit 1; }
U="app-$NAME"; DIR="$APPS_DIR/$NAME"
id "$U" >/dev/null 2>&1 && { echo "$U already exists"; exit 1; }

# --- user + folder. Home is 700: Caddy serves a root-owned copy of static sites, so nothing else needs in ---
useradd --system --home-dir "$DIR" --create-home --shell /bin/bash --user-group "$U"
mkdir -p "$DIR/.ssh" "$DIR/sites" "$DIR/logs" "$DIR/builds" "$DIR/data"
# shellcheck disable=SC2016  # literal, expanded at login
echo 'export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"' > "$DIR/.profile"
cp "$DIR/.profile" "$DIR/.bashrc"
: > "$DIR/secrets.env"

# --- deploy key: GitHub Actions gets the private half, the server keeps the public half ---
KEYTMP=$(mktemp -d); trap 'rm -rf "$KEYTMP"' EXIT
ssh-keygen -q -t ed25519 -N "" -C "github-actions-$NAME" -f "$KEYTMP/key"
echo "restrict $(cat "$KEYTMP/key.pub")" > "$DIR/.ssh/authorized_keys"

chown -R "$U:$U" "$DIR"
chmod 700 "$DIR"; chmod 700 "$DIR/sites" "$DIR/logs"; chmod 700 "$DIR/.ssh" "$DIR/builds" "$DIR/data"
chmod 600 "$DIR/.ssh/authorized_keys" "$DIR/secrets.env"

# --- resource limits shared by everything this app runs ---
cat > "/etc/systemd/system/app-$NAME.slice" <<EOF
[Unit]
Description=Resource limits for app $NAME

[Slice]
MemoryMax=$MEM
CPUQuota=$CPU
TasksMax=$TASKS
EOF
# by default an app may use any subdomain of the default domain (not the root domain itself)
G=/etc/apps/grants; touch "$G"; chmod 600 "$G"
grep -qxF "$NAME sub $BASE_DOMAIN" "$G" || echo "$NAME sub $BASE_DOMAIN" >> "$G"
systemctl daemon-reload
systemctl enable --now "app-sync@$NAME.path" >/dev/null 2>&1 || echo "warning: could not start the sites/ watcher"

KNOWN_HOSTS="$SSH_HOST $(cut -d' ' -f1,2 /etc/ssh/ssh_host_ed25519_key.pub)"
# everything a deploy needs, in one secret: apphost1:<base64url JSON>
TOKEN=$(H="$SSH_HOST" U="$U" D="$DIR" B="$BASE_DOMAIN" K="$KNOWN_HOSTS" KEY="$(cat "$KEYTMP/key")" node -e '
  const e = process.env;
  const j = { v: 1, host: e.H, port: 22, user: e.U, dir: e.D, domain: e.B, knownHosts: e.K, key: e.KEY + "\n" };
  process.stdout.write("apphost1:" + Buffer.from(JSON.stringify(j)).toString("base64url"));')

cat <<EOF

================ 1. GitHub secret (one) ================

On your laptop, run this and paste the value below when it asks:

  gh secret set APP_HOST -R $REPO

$TOKEN

(It holds the deploy key; it's shown once and not stored on the server.)

================ 2. Workflow: .github/workflows/deploy.yml ================

name: deploy
on:
  push:
    branches: [main]
  pull_request:
    types: [opened, synchronize, reopened, closed]
permissions:
  contents: read
  pull-requests: write
concurrency:
  group: deploy-\${{ github.event.pull_request.number || github.ref }}
jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        if: github.event.action != 'closed'
      - run: npm ci && npm run build      # your build; skip for plain files
        if: github.event.action != 'closed'
      - uses: sparkstonepdx/app-host/deploy@main
        with:
          app-host: \${{ secrets.APP_HOST }}
          dir: dist                       # folder to publish; add an executable "run" for a running app
          site: $NAME                     # or a hostname like client.com (needs a grant)

Pushes to main deploy to the site. Pull requests get a preview, a comment with its URL,
and are removed when the PR closes.

================ 3. Runtime environment ================

Set env vars and secrets for running apps on the server, not in GitHub:
  dashboard → $NAME → Environment,  or  app env set $NAME KEY
Running sites restart with the new values. Running apps also get \$PORT, \$SITE, \$SITE_HOST.
EOF
