#!/bin/bash
# app-sync NAME | --all      (root; runs automatically when anything in an app's sites/ folder changes)
#
# For every folder in /srv/apps/NAME/sites/:
#   - folder name = hostname: "blog" -> blog.BASE_DOMAIN, "client.com" / "www.client.com" -> exactly that
#   - the app needs a grant covering the hostname (see app-grant); first app to claim a hostname keeps it
#   - a root domain with no www folder gets www.<domain> redirecting to it
#   - contains an executable "run"  -> started as a sandboxed service with $PORT, Caddy proxies to it
#   - otherwise                     -> served as static files (200.html SPA fallback, 404.html)
# Deleted folders are unpublished and their services stopped. Names starting with "." are ignored.
# Everything the app user controls is treated as untrusted input. Root never opens a path inside an app's
# folder: static sites are copied out as the app user, env files and logs live in root-owned folders.
set -euo pipefail
. /etc/apps/config
exec 9>/run/app-sync.lock; flock 9
umask 022
ENV_DIR=/etc/apps/env        # <app>.env (app env) and <app>.user.env (copied from the app's secrets.env)
LOG_DIR=/var/log/apps        # <app>/<site>.log, readable by the app's group
WWW_DIR=/var/lib/app-host/www  # <app>/<site>: root-owned copy of each static site that Caddy serves
SITE_MAX_BYTES="${SITE_MAX_BYTES:-1073741824}"
mkdir -p "$ENV_DIR" "$LOG_DIR" "$WWW_DIR"; chmod 700 "$ENV_DIR"

unit_name() { echo "site-$1--$2.service"; }
sc() { systemctl "$@" 9>&-; }   # never let anything we start inherit the lock

GRANTS_FILE="${GRANTS_FILE:-/etc/apps/grants}"
DASHBOARD_HOST=$(sed -n 's/^DASHBOARD_HOST=//p' /etc/apps/dashboard.env 2>/dev/null || true)
HOST_RE='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$'
LABEL_RE='^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$'

host_of() { if [[ "$1" == *.* ]]; then echo "$1"; else echo "$1.$BASE_DOMAIN"; fi; }

allowed() {  # app host -> 0 if a grant covers it
  awk -v a="$1" -v h="$2" '$1==a {
      n=$3; sfx="." n; tail=substr(h, length(h)-length(sfx)+1)
      if ($2=="host" && h==n) ok=1
      if ($2=="domain" && (h==n || tail==sfx)) ok=1
      if ($2=="sub" && length(h)>length(sfx) && tail==sfx) ok=1
    } END {exit !ok}' "$GRANTS_FILE" 2>/dev/null
}
is_apex() { awk -v a="$1" -v h="$2" '$1==a && $3==h && ($2=="domain" || $2=="host") {f=1} END {exit !f}' "$GRANTS_FILE" 2>/dev/null; }

claimed_by_other() {  # app host -> 0 if another app serves it for real (not a redirect)
  grep -l -x -F "$2 {" "$CADDY_APPS_DIR"/*.caddy 2>/dev/null | grep -v -x -F "$CADDY_APPS_DIR/$1.caddy" | grep -q .
}
drop_redirects() {  # app host: a real site beats another app's automatic redirect
  local f
  for f in "$CADDY_APPS_DIR"/*.caddy; do
    [ "$f" = "$CADDY_APPS_DIR/$1.caddy" ] && continue
    grep -q -x -F "$2 { # redirect" "$f" 2>/dev/null || continue
    awk -v h="$2 { # redirect" '$0==h {skip=1; next} skip && $0=="}" {skip=0; next} !skip' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  done
}

valid_site() {  # app folder -> 0 if it may be published
  local a="$1" s="$2" h r
  [[ "$s" =~ $LABEL_RE ]] || { [[ "$s" =~ $HOST_RE ]] && [ ${#s} -le 253 ]; } || { echo "$a: '$s' is not a valid subdomain or hostname, skipped"; return 1; }
  h=$(host_of "$s")
  [ -n "$DASHBOARD_HOST" ] && [ "$h" = "$DASHBOARD_HOST" ] && { echo "$a: $h is the dashboard's address, skipped"; return 1; }
  for r in $RESERVED_SUBDOMAINS; do [ "$h" = "$r.$BASE_DOMAIN" ] && { echo "$a: $h is reserved, skipped"; return 1; }; done
  allowed "$a" "$h" || { echo "$a: not allowed to use $h (add a grant in the dashboard or with app-grant), skipped"; return 1; }
  claimed_by_other "$a" "$h" && { echo "$a: $h is already used by another app, skipped"; return 1; }
  drop_redirects "$a" "$h"
  return 0
}

port_for() {  # app sub -> existing or newly allocated port
  local p; p=$(awk -v a="$1" -v s="$2" '$1==a && $2==s {print $3}' "$PORTS_FILE")
  if [ -z "$p" ]; then
    while :; do
      p=$(shuf -i "$PORT_MIN-$PORT_MAX" -n 1)
      awk -v p="$p" '$3==p {f=1} END {exit !f}' "$PORTS_FILE" && continue
      ss -Htln "sport = :$p" | grep -q . && continue
      break
    done
    echo "$1 $2 $p" >> "$PORTS_FILE"
  fi
  echo "$p"
}

write_unit() {  # app sub port -> 0 if unchanged, 1 if (re)written
  local a="$1" s="$2" home="$APPS_DIR/$1" f; f="/etc/systemd/system/$(unit_name "$1" "$2")"
  local tmp; tmp=$(mktemp)
  cat > "$tmp" <<EOF
[Unit]
Description=$(host_of "$s") (app $a)

[Service]
User=app-$a
Group=app-$a
Slice=app-$a.slice
WorkingDirectory=$home/sites/$s
ExecStart=$home/sites/$s/run
Environment=PORT=$3 HOST=127.0.0.1 SITE=$s SITE_HOST=$(host_of "$s")
EnvironmentFile=-$ENV_DIR/$a.user.env
EnvironmentFile=-$ENV_DIR/$a.env
Restart=always
RestartSec=2
StandardOutput=append:$LOG_DIR/$a/$s.log
StandardError=append:$LOG_DIR/$a/$s.log
# network: may only listen on its own port (no stray 0.0.0.0 listeners); ordinary sockets only
SocketBindAllow=tcp:$3
SocketBindDeny=any
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# sandbox: only its own app folder is visible and writable
TemporaryFileSystem=$APPS_DIR:ro
BindPaths=$home
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
EOF
  if cmp -s "$tmp" "$f"; then rm -f "$tmp"; return 0; fi
  install -m 644 "$tmp" "$f"; rm -f "$tmp"; return 1
}

stop_unit() {  # app sub
  local u; u=$(unit_name "$1" "$2")
  sc disable --now "$u" >/dev/null 2>&1 || true
  rm -f "/etc/systemd/system/$u" "$STATE_DIR/$1--$2.id"
  sed -i "/^$1 $2 /d" "$PORTS_FILE"
}

as_app() {  # app cmd...: run as the app user, never holding our lock
  local a="$1"; shift
  runuser -u "app-$a" -- "$@" 9>&-
}

import_user_env() {  # app -> 0 if the app's own secrets.env changed. Read AS THE APP USER: a symlink gets nothing extra.
  local a="$1" out="$ENV_DIR/$1.user.env" tmp; tmp=$(mktemp)
  as_app "$a" cat "$APPS_DIR/$a/secrets.env" 2>/dev/null | head -c 65536 \
    | grep -E '^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=' | sed -E 's/^[[:space:]]*(export[[:space:]]+)?//' \
    | grep -vE '^(PORT|HOST|SITE|SITE_HOST|HOME|USER|PATH|SHELL|LOGNAME)=' > "$tmp" || true
  chmod 600 "$tmp"
  if [ -s "$tmp" ]; then cmp -s "$tmp" "$out" && { rm -f "$tmp"; return 1; }; mv "$tmp" "$out"; return 0
  else rm -f "$tmp"; [ -e "$out" ] || return 1; rm -f "$out"; return 0; fi
}

snapshot() {  # app site -> copy sites/<site> to WWW_DIR/<app>/<site> unless it's unchanged
  local a="$1" s="$2" src="$APPS_DIR/$1/sites/$2" dst="$WWW_DIR/$1/$2" idf="$STATE_DIR/$1--$2.static" id
  id=$(stat -c %i:%Y "$src")
  [ -d "$dst" ] && [ "$(cat "$idf" 2>/dev/null)" = "$id" ] && return 0
  local new="$WWW_DIR/$a/.new-$s" arc; arc=$(mktemp)
  rm -rf "$new"; mkdir -p "$new"
  # tar runs as the app user and follows its symlinks with the app's own permissions (-h); root only unpacks
  as_app "$a" tar -C "$src" -chf - . 2>/dev/null | head -c $((SITE_MAX_BYTES + 1)) > "$arc" || true
  if [ "$(stat -c %s "$arc")" -gt "$SITE_MAX_BYTES" ]; then
    rm -rf "$arc" "$new"; echo "$a: $s is over $SITE_MAX_BYTES bytes, kept the previous copy"; return 1
  fi
  tar -C "$new" -xf "$arc" --no-same-owner --no-same-permissions 2>/dev/null || true
  rm -f "$arc"
  find "$new" -type l -delete; chmod -R a+rX,go-w "$new"
  rm -rf "$dst.old"; [ -d "$dst" ] && mv "$dst" "$dst.old"; mv "$new" "$dst"; rm -rf "$dst.old"
  echo "$id" > "$idf"
}

sync_one() {
  local a="$1" home="$APPS_DIR/$1" sites="$APPS_DIR/$1/sites" out="$CADDY_APPS_DIR/$1.caddy"
  id "app-$a" >/dev/null 2>&1 || { echo "$a: not an app"; return 1; }
  local tmp; tmp=$(mktemp); echo "# generated by app-sync from $sites: do not edit" > "$tmp"
  local reload=0 seen=" " hosts=" " d s env_changed=0
  install -d -m 755 "$WWW_DIR/$a"; install -d -m 750 -o root -g "app-$a" "$LOG_DIR/$a"
  import_user_env "$a" && env_changed=1

  for d in "$sites"/*/; do
    [ -d "$d" ] || continue
    s=$(basename "$d")
    [ -L "${d%/}" ] && { echo "$a: sites/$s is a symlink, skipped"; continue; }
    valid_site "$a" "$s" || continue
    seen="$seen$s "; hosts="$hosts$(host_of "$s") "
    if [ -f "$d/run" ] && [ -x "$d/run" ] && [ ! -L "$d/run" ]; then
      local port idfile id restart=0
      port=$(port_for "$a" "$s")
      write_unit "$a" "$s" "$port" || { reload=1; restart=1; }
      # a redeploy swaps the folder, so a new inode means new code: restart
      idfile="$STATE_DIR/$a--$s.id"; id=$(stat -c %i "${d%/}")
      [ "$(cat "$idfile" 2>/dev/null)" = "$id" ] || restart=1
      [ -e "$sites/.restart-$s" ] && { restart=1; rm -f "$sites/.restart-$s"; }
      [ "$env_changed" = 1 ] && restart=1
      if [ "$restart" = 1 ]; then
        [ "$reload" = 1 ] && { sc daemon-reload; reload=0; }
        sc enable "$(unit_name "$a" "$s")" >/dev/null 2>&1
        sc restart "$(unit_name "$a" "$s")"
        echo "$id" > "$idfile"
      fi
      printf '%s {\n\treverse_proxy 127.0.0.1:%s\n}\n' "$(host_of "$s")" "$port" >> "$tmp"
    else
      # static: if it used to be a running site, stop that
      [ -f "/etc/systemd/system/$(unit_name "$a" "$s")" ] && { stop_unit "$a" "$s"; reload=1; }
      snapshot "$a" "$s" || [ -d "$WWW_DIR/$a/$s" ] || continue
      printf '%s {\n\troot * %s\n\ttry_files {path} {path}/ /200.html\n\tfile_server\n\thandle_errors {\n\t\trewrite * /404.html\n\t\tfile_server\n\t}\n}\n' \
        "$(host_of "$s")" "$WWW_DIR/$a/$s" >> "$tmp"
    fi
  done

  # root domains without their own www folder: www.<domain> redirects to <domain>
  local h w
  for h in $hosts; do
    w="www.$h"
    is_apex "$a" "$h" || continue
    [[ "$hosts" == *" $w "* ]] && continue
    allowed "$a" "$w" || continue
    claimed_by_other "$a" "$w" && continue
    printf '%s { # redirect\n\tredir https://%s{uri} permanent\n}\n' "$w" "$h" >> "$tmp"
  done
  rm -f "$sites"/.restart-* 2>/dev/null || true

  # running sites whose folder is gone
  local gone
  # shellcheck disable=SC2013  # subdomains are single words
  for gone in $(awk -v a="$a" '$1==a {print $2}' "$PORTS_FILE"); do
    [[ "$seen" == *" $gone "* ]] && continue
    stop_unit "$a" "$gone"; reload=1
  done
  [ "$reload" = 1 ] && sc daemon-reload

  # static copies whose site is gone
  local w2
  for w2 in "$WWW_DIR/$a"/*/; do
    [ -d "$w2" ] || continue
    [[ "$seen" == *" $(basename "$w2") "* ]] && [ ! -f "$sites/$(basename "$w2")/run" ] && continue
    rm -rf "$w2" "$STATE_DIR/$a--$(basename "$w2").static"
  done

  local old=""; [ -f "$out" ] && old=$(cat "$out")
  install -m 644 "$tmp" "$out"; rm -f "$tmp"
  if caddy validate --config /etc/caddy/Caddyfile >/dev/null 2>&1; then
    [ "$(cat "$out")" = "$old" ] || sc reload caddy
    grep -E '^[a-z0-9.-]+ [{]$' "$out" | sed "s/ {$//; s/^/$a: live https:\/\//" || echo "$a: no sites"
    grep -E '^[a-z0-9.-]+ [{] # redirect$' "$out" | sed "s/ { # redirect$//; s/^/$a: redirect https:\/\//" || true
  else
    if [ -n "$old" ]; then printf '%s\n' "$old" > "$out"; else rm -f "$out"; fi
    echo "$a: generated Caddy config failed to validate; kept the previous one"; return 1
  fi
}

if [ "${1:-}" = "--all" ]; then
  for h in "$APPS_DIR"/*/; do [ -d "$h" ] && { sync_one "$(basename "$h")" || true; }; done
else
  [ -n "${1:-}" ] || { echo "usage: app-sync NAME | --all"; exit 1; }
  sync_one "$1"
fi
