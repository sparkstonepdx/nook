#!/bin/bash
# app: the deploy helper, run as an app user (over SSH from GitHub Actions, or by hand).
#   app site deploy DIR SUBDOMAIN   publish DIR at https://SUBDOMAIN.<base domain> (atomic swap)
#   app site rm SUBDOMAIN           take it down
#   app site restart SUBDOMAIN      restart a running app
#   app site list                   what's live
#   app site logs SUBDOMAIN [N]     last N lines (default 100) of a running app's log
# A folder with an executable "run" is started as a service on $PORT; anything else is served as static files.
set -euo pipefail
S="$HOME/sites"
[ -d "$S" ] || { echo "app: run this as an app user"; exit 1; }
sub() { [[ "${1:-}" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || { echo "bad subdomain: '${1:-}' (lowercase letters, digits, dashes)"; exit 1; }; }
wait_live() { sleep 3; }

[ "${1:-}" = site ] || { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
case "${2:-}" in
  deploy)
    src="${3:-}"; s="${4:-}"
    [ -d "$src" ] || { echo "usage: app site deploy DIR SUBDOMAIN"; exit 1; }; sub "$s"
    rm -rf "$S/.new-$s" "$S/.old-$s"
    cp -a "$src" "$S/.new-$s"
    chmod -R a+rX,go-w "$S/.new-$s"
    if [ -d "$S/$s" ]; then mv "$S/$s" "$S/.old-$s"; fi
    mv "$S/.new-$s" "$S/$s"
    rm -rf "$S/.old-$s"
    kind=static; [ -x "$S/$s/run" ] && kind="running app"
    wait_live; echo "deployed $s ($kind)";;
  rm) sub "${3:-}"; rm -rf "${S:?}/$3"; echo "removed $3";;
  restart) sub "${3:-}"; [ -x "$S/$3/run" ] || { echo "$3 is not a running app"; exit 1; }; touch "$S/.restart-$3"; wait_live; echo "restarted $3";;
  list)
    for d in "$S"/*/; do [ -d "$d" ] || continue; n=$(basename "$d")
      if [ -x "$d/run" ]; then echo "$n  (running app)"; else echo "$n  (static)"; fi; done;;
  logs) sub "${3:-}"; tail -n "${4:-100}" "$HOME/logs/$3.log" 2>/dev/null || echo "no log for $3 yet";;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1;;
esac
