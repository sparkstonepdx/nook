[Unit]
Description=app-host dashboard
After=network.target

[Service]
EnvironmentFile=/etc/apps/dashboard.env
ExecStart=/usr/bin/node /usr/local/lib/app-host/dashboard/server.mjs
Restart=always
# runs as root: it calls app-create, app-delete, userdel, systemctl
MemoryMax=96M
PrivateTmp=true

[Install]
WantedBy=multi-user.target
